# Application
APP_ENV=local
APP_URL=http://localhost:3000
VERCEL_AUTOMATION_BYPASS_SECRET=test-secret
# Supabase (run `supabase status` after starting the local stack)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-secret-or-service-role-key

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-1
# USD rates per 1M tokens, keyed by exact model name; see docs/development/configuration.md.
# Update these when provider pricing changes. Empty pricing still records usage but displays costs as unavailable.
OPENAI_PRICING_JSON='{"gpt-5-mini":{"kind":"chat_text","input":0.25,"cachedInput":0.025,"output":2},"gpt-image-1":{"kind":"image_generation","textInput":5,"imageInput":10,"imageOutput":40}}'

# Inngest
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
