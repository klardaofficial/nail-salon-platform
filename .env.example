# Application
APP_ENV=local
APP_URL=http://localhost:3000
BOT_LOCALE=de
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase (run `supabase status` after starting the local stack)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-secret-or-service-role-key

# WhatsApp Cloud API
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=
WHATSAPP_TEMPLATE_BOOKING_CANCELLED=

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Inngest
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Operational fallback defaults for a new environment
PLATFORM_TIMEZONE=Europe/Berlin
DEFAULT_OPEN_TIME=09:00
DEFAULT_CLOSE_TIME=18:00
DEFAULT_BOOKING_INTERVAL_MINUTES=30
PREVIEW_REQUESTS_PER_DAY=3
PREVIEWS_PER_REQUEST=3
