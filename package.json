{
  "name": "nail-salon-platform",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Multi-salon WhatsApp booking and customer engagement platform",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:run && pnpm build",
    "inngest:dev": "inngest dev --no-discovery -u http://localhost:3000/api/inngest",
    "whatsapp:simulate": "tsx scripts/whatsapp-simulator.ts",
    "db:start": "supabase start",
    "db:status": "supabase status",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/generated/database.types.ts"
  },
  "dependencies": {
    "@ant-design/charts": "2.6.7",
    "@ant-design/nextjs-registry": "1.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "antd": "6.6.4",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "dayjs": "1.11.23",
    "inngest": "4.20.0",
    "next": "16.3.5",
    "openai": "7.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "swr": "2.5.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "inngest-cli": "1.44.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "supabase": "2.117.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
